<Project>
  <!-- Shared settings for every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- XML doc comments feed the OpenAPI descriptions; missing comments are not an error. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: not every public member needs a doc comment. CS1573: a <param> tag may document only the surprising parameter. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
</Project>
