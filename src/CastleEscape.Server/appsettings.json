{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Game": {
    "TickRate": 20,
    "PowerDurationSeconds": 10,
    "DoorMode": "Latch",
    "RespawnPlayerOnHit": false,
    "GridWidth": 24,
    "GridHeight": 16,
    "MaxLevel": 10
  },
  "Generation": {
    "MaxAttempts": 50,
    "RequirePowerOnCriticalPath": false,
    "MinZombieDistanceFromStart": 5
  },
  "Patterns": {
    "PrototypeCloneMode": "Deep"
  },
  "Realtime": {
    "EnabledChannels": [ "SignalR", "Polling" ],
    "PollingBufferSize": 200
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000", "http://localhost:5035" ]
  },
  "DevTools": {
    "Enabled": false
  }
}
